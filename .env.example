# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
DOMAIN=localhost # Set to your Cloudflare domain on EC2 (e.g. docproc.yourdomain.com)

# PostgreSQL + pgvector Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docproc
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docproc_test

# Document Ingestion
MAX_FILE_SIZE_BYTES=20971520 # 20 MB
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# Retrieval & RAG
DEFAULT_TOP_K=5
RELEVANCE_THRESHOLD=0.5

# Workflow Guardrails
MAX_WORKFLOW_STEPS=10
MAX_TOOL_CALLS=6
TOOL_TIMEOUT_SECONDS=15
PROVIDER_MAX_RETRIES=2

# Providers & Model Config
LLM_PROVIDER=mock # mock | openai | gemini
EMBEDDING_PROVIDER=mock # mock | openai | gemini
EMBEDDING_DIMENSION=1536
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
